generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model clado {
  id_clado           Int                  @id @default(autoincrement())
  nome_clado         String               @unique @db.VarChar(100)
  nivel_taxonomico   String?              @db.VarChar(50)
  descricao          String?
  id_ancestral       Int?
  clado              clado?               @relation("cladoToclado", fields: [id_ancestral], references: [id_clado], onUpdate: NoAction)
  other_clado        clado[]              @relation("cladoToclado")
  especie_dinossauro especie_dinossauro[]
}

model especie_dinossauro {
  id_especie        Int                @id @default(autoincrement())
  nome_cientifico   String             @unique @db.VarChar(150)
  nome_popular      String?            @db.VarChar(150)
  id_periodo        Int?
  id_clado          Int?
  dieta             String?            @db.VarChar(50)
  altura_m          Float?
  comprimento_m     Float?
  peso_estimado_kg  Float?
  descricao         String?
  ano_descoberta    String?            @db.VarChar(50)
  url_imagem        String?
  clado             clado?             @relation(fields: [id_clado], references: [id_clado], onUpdate: NoAction)
  periodo_geologico periodo_geologico? @relation(fields: [id_periodo], references: [id_periodo], onUpdate: NoAction)
  fossil            fossil[]
}

model fossil {
  id_fossil          Int                 @id @default(autoincrement())
  id_especie         Int?
  localidade_exata   String?             @db.VarChar(255)
  latitude           Float?
  longitude          Float?
  especie_dinossauro especie_dinossauro? @relation(fields: [id_especie], references: [id_especie], onDelete: Cascade, onUpdate: NoAction)
}

model periodo_geologico {
  id_periodo         Int                  @id @default(autoincrement())
  nome_periodo       String               @unique @db.VarChar(100)
  inicio_ma          Float?
  fim_ma             Float?
  especie_dinossauro especie_dinossauro[]
}
